# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/enterprise_rag

# JWT
JWT_SECRET=replace_with_a_32_plus_character_random_secret
JWT_EXPIRES_SECONDS=3600

# Authentication / enterprise OIDC
OIDC_ENABLED=true
OIDC_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/oauth2callback
OIDC_COOKIE_SECRET=replace_with_a_strong_random_cookie_secret

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra OIDC
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Centralized audit logging
AUDIT_LOGGING=true

# LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant: use QDRANT_URL + QDRANT_API_KEY for Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
QDRANT_PATH=./qdrant_data

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag-rbac

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
