# REQUIRED: generate a long random secret; never commit the real value
JWT_SECRET=replace_with_a_32_plus_character_random_secret
JWT_EXPIRES_SECONDS=3600

# LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant: use QDRANT_URL + QDRANT_API_KEY for Qdrant Cloud.
# Leave QDRANT_URL empty to use local embedded storage at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents
QDRANT_PATH=./qdrant_data

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag-rbac

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
